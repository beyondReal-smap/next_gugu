  "readingRule": "한국어 구구단 낭독은 '앞수 뒷수 → 답' 순서입니다. 답이 한 자리면 뒷수 뒤에 '은/는'을 붙이고(예: 이 삼은 육), 답이 두 자리면 붙이지 않습니다(예: 삼 사 십이).",
  "table": 3,
  "name": "3단",
  "learnOrder": 3,
  "difficulty": "easy",
  "difficultyRank": 3,
  "summary": "3단은 2단에 한 번 더 더하는 단입니다. 3 × 7은 2 × 7(14)에 7을 더한 21입니다.",
  "whyMatters": "3단을 익히면 6단(3단의 두 배)과 9단(3단의 세 배)으로 곧장 확장됩니다.",
  "pattern": "답의 각 자리 숫자를 더하면 항상 3의 배수가 됩니다. 예: 24 → 2+4=6, 27 → 2+7=9",
  "strategies": [
    {
      "title": "2단 + 한 번 더",
      "detail": "3 × 8이 막히면 2 × 8 = 16에 8을 더해 24를 만듭니다. 이미 아는 2단을 발판으로 쓰는 방식입니다."
    },
    {
      "title": "3씩 뛰어 세기 리듬",
      "detail": "3, 6, 9, 12, 15, 18, 21, 24, 27을 박수와 함께 소리 내면 순서 기억이 강해집니다."
    },
    {
      "title": "자릿수 합 검산",
      "detail": "답이 3의 배수인지 자릿수 합으로 확인합니다. 3 × 9 = 27이면 2+7=9라 3의 배수가 맞습니다."
    }
  ],
  "commonMistakes": [
    {
      "fact": "3x7",
      "correct": 21,
      "confusedWith": [
        24,
        18
      ],
      "why": "3단 후반부는 답 간격이 좁아 3 × 8(24)과 섞입니다.",
      "fix": "3 × 7 = 21을 '스물하나'로 또렷하게 소리 내 3 × 8과 분리합니다."
    },
    {
      "fact": "3x6",
      "correct": 18,
      "confusedWith": [
        15,
        21
      ],
      "why": "5 × 3(15)과 위치가 가까워 앞뒤 답으로 밀립니다.",
      "fix": "3 × 6은 6 × 3과 같다는 점을 이용해 6단 쪽 기억으로도 확인합니다."
    }
  ],
