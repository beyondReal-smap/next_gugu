  "difficulty": "medium",
  "difficultyRank": 4,
  "summary": "4단은 2단을 두 번 적용하는 단입니다. 4 × 7은 7을 두 배(14) 한 뒤 다시 두 배(28) 하면 됩니다.",
  "whyMatters": "'두 배의 두 배' 전략을 몸에 익히면 8단(다시 두 배)까지 같은 방법으로 해결됩니다.",
  "pattern": "답이 모두 짝수이고 4씩 커집니다. 4 · 8 · 12 · 16 · 20 · 24 · 28 · 32 · 36",
  "strategies": [
    {
      "title": "두 배의 두 배",
      "detail": "4 × 6 = (6의 두 배 12)의 두 배 = 24. 4단을 통째로 외우지 않아도 2단만으로 만들어 낼 수 있습니다."
    },
    {
      "title": "5단에서 한 묶음 빼기",
      "detail": "4 × 8이 막히면 5 × 8 = 40에서 8을 빼 32를 얻습니다. 5단이 5·0으로 끝나 계산이 쉬운 점을 활용합니다."
    },
    {
      "title": "20을 기준점으로",
      "detail": "4 × 5 = 20을 중간 말뚝으로 삼아 앞뒤로 4씩 오르내리면 후반부가 안정됩니다."
    }
  ],
  "commonMistakes": [
    {
      "fact": "4x7",
      "correct": 28,
      "confusedWith": [
        24,
        32
      ],
      "why": "4 × 6(24), 4 × 8(32)과 4 간격으로 붙어 있어 한 칸씩 밀립니다.",
      "fix": "7의 두 배는 14, 14의 두 배는 28이라고 두 단계로 되짚습니다."
    },
    {
      "fact": "4x8",
      "correct": 32,
      "confusedWith": [
        28,
        36
      ],
      "why": "30을 넘어가는 지점이라 자릿수가 흔들립니다.",
      "fix": "4 × 8 = 32와 8 × 4 = 32를 같이 외워 두 방향에서 확인합니다."
    }
  ],
