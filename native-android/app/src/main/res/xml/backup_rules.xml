<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 6~11 자동 백업(fullBackupContent) — 기기에 묶인 값은 백업·복원 대상에서 뺀다.
  gugu_device.xml 에는 세션 토큰·학습 신원(installId)·아웃박스가 들어 있다 (Persistence.DEVICE_PREFS_NAME).
  진행도가 든 gugu.xml 은 기기를 바꿀 때 유일한 복구 수단이라 백업에 그대로 둔다.
  <include> 는 쓰지 않는다 — 쓰는 순간 나머지 파일이 전부 백업에서 빠진다.
  .bak 은 SharedPreferences 가 쓰는 도중 잠깐 만드는 임시 사본이다 — 그때 백업이 돌아 복원되면 정본으로 승격되므로 함께 뺀다.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="gugu_device.xml" />
    <exclude domain="sharedpref" path="gugu_device.xml.bak" />
    <!-- Firebase(FCM) 가 기기에 남기는 파일 — 에뮬레이터(API 36)에서 run-as 로 확인한 실제 이름 (2026-10-19).
         appid.xml = FCM 토큰·토픽 대기열, messaging.xml = 자동 초기화 값, HeartBeat = 사용일 기록, datatransport = 전송 대기 이벤트.
         설치 ID(no_backup/PersistedInstallation.*.json)는 noBackupFilesDir 라 자동 제외된다. -->
    <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
    <exclude domain="sharedpref" path="com.google.firebase.messaging.xml" />
    <exclude domain="file" path="datastore/FirebaseHeartBeatW0RFRkFVTFRd+MToyMjg3NzYwNDY0Mzk6YW5kcm9pZDphMWVlNzcyNjU0MzRjMWRiNmU0OWMy.preferences_pb" />
    <exclude domain="database" path="com.google.android.datatransport.events" />
    <exclude domain="database" path="com.google.android.datatransport.events-journal" />
</full-backup-content>
