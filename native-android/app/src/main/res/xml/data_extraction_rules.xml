<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 백업·기기 이전 규칙(dataExtractionRules) — backup_rules.xml 과 같은 제외 규칙을
  클라우드 백업과 기기 간 이전 양쪽에 건다. 둘 중 하나만 빠져도 토큰이 새 기기로 복제된다.
  <include> 는 쓰지 않는다 — 쓰는 순간 나머지 파일이 전부 빠진다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="gugu_device.xml" />
        <exclude domain="sharedpref" path="gugu_device.xml.bak" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gugu_device.xml" />
        <exclude domain="sharedpref" path="gugu_device.xml.bak" />
    </device-transfer>
</data-extraction-rules>
