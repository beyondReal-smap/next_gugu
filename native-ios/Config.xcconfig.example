// Supabase 설정 — 실제 값은 Config.xcconfig (gitignore) 에 넣는다.
// 복사: cp Config.xcconfig.example Config.xcconfig 후 값 채우기
//
// xcconfig 는 // 를 주석으로 잘라내므로 URL 스킴을 넣지 않는다.
// 호스트만 적고 https:// 는 SupabaseConfig 가 붙인다.
//
// anon key 는 클라이언트에 공개되는 키로 설계돼 있어 앱 번들 포함이 정상이다.
// service_role 키는 절대 여기에 넣지 않는다.

SUPABASE_HOST = <project-ref>.supabase.co
SUPABASE_ANON_KEY = <anon key>
