    "위 길로 이동" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Move to upper lane"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "上の みちへ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위 길로 이동"
          }
        }
      }
    },
    "위아래로 길을 옮겨 장애물을 피하고, 문제가 나오면 정답 숫자가 적힌 길로 들어가요. 부딪히거나 틀리면 하트가 하나 줄어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Switch lanes up and down to dodge obstacles. When a problem appears, go into the lane with the right answer. Bump into something or pick wrong and you lose a heart."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "上下に みちを かえて じゃまものを よけよう。もんだいが 出たら 正かいの 数字の みちに 入ってね。ぶつかったり まちがえたり すると ハートが 1つ へるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위아래로 길을 옮겨 장애물을 피하고, 문제가 나오면 정답 숫자가 적힌 길로 들어가요. 부딪히거나 틀리면 하트가 하나 줄어요."
          }
        }
      }
    },
    "위아래로 길을 옮겨 장애물을 피해요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Switch lanes up and down to dodge obstacles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "上下に みちを かえて じゃまものを よけよう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위아래로 길을 옮겨 장애물을 피해요."
          }
        }
      }
    },
    "유령 휘휘" : {
      "comment" : "어드벤처 주민 이름 — 언어별로 새로 짓기 (음역 금지)",
      "localizations" : {
        "en" : {
