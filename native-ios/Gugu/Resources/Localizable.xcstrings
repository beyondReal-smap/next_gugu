        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "दूसरे डिवाइस पर भी इस ईमेल से साइन इन कर सकते हैं। पास वाले उपयोगकर्ताओं के सीखने के रिकॉर्ड सुरक्षित रखे जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
