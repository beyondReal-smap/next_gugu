    "레벨 · 스트릭 · 마스터리를 모으며 자연스럽게 구구단을 익혀요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Earn levels, streaks and mastery as you learn your times tables naturally."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्तर बढ़ाते, लगातार अभ्यास करते और महारत पाते हुए पहाड़े आसानी से सीखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kuasai perkalian sambil menaikkan level, menjaga rutinitas, dan mengumpulkan bintang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "レベル・れんぞくきろく・マスターを あつめながら、しぜんに 九九を おぼえよう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레벨 · 스트릭 · 마스터리를 모으며 자연스럽게 구구단을 익혀요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lên cấp, học liên tục và thu thập sao để ghi nhớ bảng nhân tự nhiên."
          }
        }
      }
