              }
            }
          }
        },
        "hi" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "दूसरे खाते से साइन इन करने पर, अब तक अपलोड न हुआ सीखने का %lld रिकॉर्ड सर्वर पर नहीं बचेगा।"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "दूसरे खाते से साइन इन करने पर, अब तक अपलोड न हुए सीखने के %lld रिकॉर्ड सर्वर पर नहीं बचेंगे।"
                }
              }
            }
          }
        },
        "id" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "Jika masuk dengan akun lain, %lld catatan belajar yang belum diunggah tidak akan tersimpan di server."
