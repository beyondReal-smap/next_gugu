    "다른 계정으로 로그인하면 아직 서버에 올리지 못한 학습 기록 %lld개는 서버에 남지 않아요." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "If you sign in to a different account, %lld learning record not yet uploaded won't be saved to the server."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "If you sign in to a different account, %lld learning records not yet uploaded won't be saved to the server."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "別のアカウントでログインすると、まだサーバーに送っていない学習記録 %lld件はサーバーに残りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 계정으로 로그인하면 아직 서버에 올리지 못한 학습 기록 %lld개는 서버에 남지 않아요."
          }
        }
      }
    },
    "다른 기기에서도 이 이메일로 로그인하면 이용권과 학습 기록을 이어서 쓸 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sign in with this email on another device to keep using your Lifetime Pass and learning records."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ほかの端末でもこのメールアドレスでログインすれば、買い切りパスと学習記録を引き続き使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기에서도 이 이메일로 로그인하면 이용권과 학습 기록을 이어서 쓸 수 있어요."
          }
        }
      }
    },
    "다른 기기에서도 이 이메일로 로그인할 수 있어요. 학습 기록 보관은 이용권 사용자에게 켜져요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "You can sign in with this email on other devices too. Record backup is turned on for Lifetime Pass users."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ほかの端末でもこのメールアドレスでログインできます。学習記録の保存は、買い切りパスをお持ちの方に有効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기에서도 이 이메일로 로그인할 수 있어요. 학습 기록 보관은 이용권 사용자에게 켜져요."
          }
