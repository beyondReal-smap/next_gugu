        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इस डिवाइस के तारे, स्तर और सिक्के वैसे ही रहेंगे। खाते का पास और सीखने के रिकॉर्ड लोड होंगे।"
