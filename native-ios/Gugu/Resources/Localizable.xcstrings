    "위 길로 이동" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Move to upper lane"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ऊपर वाले रास्ते पर जाएँ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pindah ke jalur atas"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "上の みちへ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위 길로 이동"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chuyển lên làn trên"
          }
        }
      }
    },
    "위아래로 길을 옮겨 장애물을 피하고, 문제가 나오면 정답 숫자가 적힌 길로 들어가요. 부딪히거나 틀리면 하트가 하나 줄어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Switch lanes up and down to dodge obstacles. When a problem appears, go into the lane with the right answer. Bump into something or pick wrong and you lose a heart."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ऊपर-नीचे रास्ते बदलकर बाधाओं से बचें। सवाल आने पर सही संख्या वाले रास्ते में जाएँ। टकराने या गलत जवाब पर एक दिल कम होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pindah ke atas atau bawah untuk menghindari rintangan. Saat soal muncul, masuk ke jalur angka jawaban benar. Tabrakan atau jawaban salah mengurangi satu hati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "上下に みちを かえて じゃまものを よけよう。もんだいが 出たら 正かいの 数字の みちに 入ってね。ぶつかったり まちがえたり すると ハートが 1つ へるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
