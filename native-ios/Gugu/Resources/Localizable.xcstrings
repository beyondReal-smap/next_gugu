    },
    "다른 기기에서도 이 이메일로 로그인하면 이용권과 학습 기록을 이어서 쓸 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sign in with this email on another device to keep using your Lifetime Pass and learning records."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "दूसरे डिवाइस पर इसी ईमेल से साइन इन करके पास और सीखने के रिकॉर्ड इस्तेमाल कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
