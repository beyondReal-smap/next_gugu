                }
              }
            }
          }
        }
      }
    },
    "하트 3개 · 3번째 웨이브마다 짝꿍 보스가 나와요. 단별 최고 기록은 이 기기에 저장돼요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "3 hearts · A pair boss appears every 3rd wave. Best scores for each table are saved on this device."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "3 दिल · हर तीसरी लहर में जोड़ी वाला बड़ा दुश्मन आएगा। हर पहाड़े का सर्वश्रेष्ठ रिकॉर्ड इस डिवाइस पर सहेजा जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "3 hati · Bos pasangan muncul setiap gelombang ketiga. Rekor terbaik tiap perkalian disimpan di perangkat ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ハート3こ · 3ウェーブごとに ペアボスが 出るよ。だんごとの さいこう きろくは この きかいに ほぞんされるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하트 3개 · 3번째 웨이브마다 짝꿍 보스가 나와요. 단별 최고 기록은 이 기기에 저장돼요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "3 trái tim · Trùm ghép cặp xuất hiện mỗi 3 đợt. Kỷ lục từng bảng nhân được lưu trên thiết bị này."
          }
        }
      }
    },
    "하트 3개 · 정답 3개마다 조금씩 빨라져요. 단별 최고 기록은 이 기기에 저장돼요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "3 hearts · It gets a little faster every 3 correct answers. Best scores for each table are saved on this device."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "3 दिल · हर 3 सही जवाब पर गति थोड़ी बढ़ती है। हर पहाड़े का सर्वश्रेष्ठ रिकॉर्ड इस डिवाइस पर सहेजा जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "3 hati · Makin cepat setiap 3 jawaban benar. Rekor terbaik tiap perkalian disimpan di perangkat ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ハート3つ · 3もん 正かいするごとに 少しずつ はやくなるよ。だんごとの さいこう きろくは この きかいに ほぞんされるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하트 3개 · 정답 3개마다 조금씩 빨라져요. 단별 최고 기록은 이 기기에 저장돼요."
          }
        },
        "vi" : {
