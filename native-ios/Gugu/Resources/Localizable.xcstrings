          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pengaturan perangkat"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "端末の設定"
          }
        },
        "ko" : {
          "stringUnit" : {
