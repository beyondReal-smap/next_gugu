    "하루 목표" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Daily Goal"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "दैनिक लक्ष्य"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Target Harian"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1日の もくひょう"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 목표"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mục tiêu mỗi ngày"
          }
        }
      }
    },
    "하루 한 번, 오늘의 구구단을 알려 드려요. 밤에는 보내지 않아요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Once a day, we'll remind you about today's times tables. No notifications at night."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "दिन में एक बार आज के पहाड़े याद दिलाएँगे। रात में सूचनाएँ नहीं भेजेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kami mengingatkan latihan perkalian sekali sehari. Tidak ada pemberitahuan malam hari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1日1回、今日の九九をお知らせします。夜間は送りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 한 번, 오늘의 구구단을 알려 드려요. 밤에는 보내지 않아요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mỗi ngày nhắc bạn học bảng nhân một lần. Không gửi thông báo vào ban đêm."
          }
        }
      }
    },
    "하루에 맞힐 정답 수를 골라요. 목표를 채우면 그날 학습 알림은 쉬어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choose how many correct answers to aim for each day. Once you reach the goal, practice reminders take the rest of the day off."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर दिन कितने सही जवाब देने हैं, चुनें। लक्ष्य पूरा होने पर उस दिन अभ्यास की सूचनाएँ नहीं आएँगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pilih target jawaban benar setiap hari. Setelah target tercapai, pengingat belajar berhenti untuk hari itu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1日に 正かいする 数を えらぼう。もくひょうを たっせいすると、その日の 学習リマインダーは お休みだよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루에 맞힐 정답 수를 골라요. 목표를 채우면 그날 학습 알림은 쉬어요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chọn số câu đúng cần đạt mỗi ngày. Khi đạt mục tiêu, sẽ không nhắc học thêm trong ngày đó."
          }
        }
      }
    },
    "하루에 맞힐 정답 수예요. 목표를 채우면 그날 알림은 쉬어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Correct answers to aim for each day. Reminders take the rest of the day off once the goal is met."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर दिन इतने सही जवाब देने हैं। लक्ष्य पूरा होने पर उस दिन सूचनाएँ नहीं आएँगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Target jawaban benar setiap hari. Pengingat berhenti untuk hari itu setelah target tercapai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1日に目指す正解の数です。目標を達成すると、その日の通知はお休みします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루에 맞힐 정답 수예요. 목표를 채우면 그날 알림은 쉬어요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Số câu đúng cần đạt mỗi ngày. Khi đạt mục tiêu, sẽ ngừng nhắc trong ngày đó."
          }
        }
      }
    },
    "하트 %lld개" : {
      "localizations" : {
        "en" : {
