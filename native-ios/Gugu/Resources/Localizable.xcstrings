    "정답 길 %lld개를 지날 때마다 속도가 한 단계 빨라져요. 앱을 벗어나면 자동으로 일시정지해요." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "Every time you pass %lld correct lane, the speed goes up one level. The game pauses by itself if you leave the app."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "Every time you pass %lld correct lanes, the speed goes up one level. The game pauses by itself if you leave the app."
                }
              }
            }
          }
        },
        "hi" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "हर %lld सही रास्ता पार करने पर गति एक स्तर बढ़ेगी। ऐप से बाहर जाने पर खेल अपने आप रुक जाएगा।"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "हर %lld सही रास्ते पार करने पर गति एक स्तर बढ़ेगी। ऐप से बाहर जाने पर खेल अपने आप रुक जाएगा।"
                }
              }
            }
          }
        },
        "id" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "Setiap %lld jalur benar, kecepatan naik satu tingkat. Permainan otomatis dijeda saat keluar dari aplikasi."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
