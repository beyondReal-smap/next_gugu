          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "गुगु रोमांच"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Petualangan Gugu"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "九九アドベンチャー"
          }
        },
        "ko" : {
          "stringUnit" : {
