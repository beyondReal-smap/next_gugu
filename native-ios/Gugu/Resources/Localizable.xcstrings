              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "हर %lld बाधाएँ पार करने पर गति एक स्तर बढ़ेगी। ऐप से बाहर जाने पर खेल अपने आप रुक जाएगा।"
