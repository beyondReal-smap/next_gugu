        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ sudah memiliki akun. Masukkan kode 6 digit dari email untuk masuk ke akun tersebut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ はすでに使われているアカウントです。メールで届いた6桁のコードを入力すると、そのアカウントでログインします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 은 이미 쓰던 계정이에요. 메일로 받은 6자리 코드를 넣으면 그 계정으로 로그인해요."
