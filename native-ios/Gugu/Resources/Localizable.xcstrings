    "매일 %@에 알려드릴게요. 프로필 > 설정에서 바꿀 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "We'll remind you every day at %@. You can change this in Profile > Settings."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर दिन %@ पर याद दिलाएँगे। इसे प्रोफ़ाइल > सेटिंग में बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kami akan mengingatkan setiap hari pukul %@. Ubah di Profil > Pengaturan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "毎日%@にお知らせします。プロフィール > 設定 で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 %@에 알려드릴게요. 프로필 > 설정에서 바꿀 수 있어요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sẽ nhắc bạn lúc %@ mỗi ngày. Có thể đổi tại Hồ sơ > Cài đặt."
          }
        }
      }
    },
    "매일 %@에 오늘의 구구단을 알려드려요. 밤에는 보내지 않아요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "We'll send today's times tables every day at %@. No notifications at night."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर दिन %@ पर आज के पहाड़े याद दिलाएँगे। रात में सूचनाएँ नहीं भेजेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kami akan mengingatkan latihan perkalian setiap hari pukul %@. Tidak ada pemberitahuan malam hari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "毎日%@に今日の九九をお知らせします。夜には送りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 %@에 오늘의 구구단을 알려드려요. 밤에는 보내지 않아요."
          }
        },
        "vi" : {
