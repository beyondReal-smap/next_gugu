      }
    },
    "이 기기에서 로그아웃" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sign out on this device"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この端末でログアウト"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 로그아웃"
          }
        }
      }
    },
    "이 기기의 별·레벨·코인과 이 기기에서 산 이용권은 그대로예요. 계정으로 받은 이용권과 학습 기록 보관은 다시 로그인하면 돌아와요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stars, levels, coins, and passes bought on this device stay as they are. Passes from your account and record backup come back when you sign in again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この端末のほし・レベル・コインと、この端末で購入したパスはそのまま残ります。アカウントで受け取ったパスと記録の保存は、もう一度ログインすると戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 별·레벨·코인과 이 기기에서 산 이용권은 그대로예요. 계정으로 받은 이용권과 학습 기록 보관은 다시 로그인하면 돌아와요."
          }
        }
      }
    },
    "이 기기의 별·레벨·코인은 그대로 두고, 계정의 이용권과 학습 기록을 불러와요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stars, levels, and coins on this device stay as they are. Your account's pass and learning records will be loaded."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この端末のほし・レベル・コインはそのままで、アカウントのパスと学習記録を読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 별·레벨·코인은 그대로 두고, 계정의 이용권과 학습 기록을 불러와요."
          }
        }
      }
    },
    "이 이메일 주소는 쓸 수 없어요. 다른 주소를 넣어 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This email address can't be used. Please enter a different one."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このメールアドレスは使用できません。別のアドレスを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이메일 주소는 쓸 수 없어요. 다른 주소를 넣어 주세요."
          }
        }
      }
    },
    "이 이메일로 만든 계정이 없어요. 주소를 확인해 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
