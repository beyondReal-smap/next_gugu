    "레벨·별·업적·기록이 모두 처음으로 돌아가요. 되돌릴 수 없어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Levels, stars, achievements and records will all be reset. This can't be undone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्तर, तारे, उपलब्धियाँ और रिकॉर्ड सब फिर से शुरू होंगे। इसे वापस नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Level, bintang, pencapaian, dan catatan akan direset. Tindakan ini tidak bisa dibatalkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "レベル・ほし・実績・記録がすべて最初の状態に戻ります。元に戻すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레벨·별·업적·기록이 모두 처음으로 돌아가요. 되돌릴 수 없어요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cấp độ, sao, thành tích và lịch sử sẽ về ban đầu. Không thể hoàn tác."
          }
        }
      }
