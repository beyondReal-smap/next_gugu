          }
        }
      }
    },
    "이 지역의 보스다. %lld단, 각오는 됐지?" : {
      "comment" : "보스 기본 인사말 — %lld 는 단",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I'm the boss of this area. Ready for the %lld times table?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この ちいきの ボスだ。%lldのだん、かくごは いいか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 지역의 보스다. %lld단, 각오는 됐지?"
          }
